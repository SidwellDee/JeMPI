# General
CLUSTERED_MODE=false

# Log
DEBUG=0
BASHLOG_FILE=0
BASHLOG_FILE_PATH=platform.log

# Message Bus - Kafka
#  !NOTE: Topics should comma seperated, optional include partion and repliction values
#   e.g. <topic>:<partions>:<replicationFactor> -> test:3:2 (defaults to <topics>:3:1)
KAFKA_TOPICS=2xx,2xx-async,errors,reprocess,3xx,patient,observation,JeMPI-audit-trail

# SSO
KC_OPENHIM_SSO_ENABLED=true
OPENHIM_CONSOLE_SHOW_LOGIN=false
KC_JEMPI_SSO_ENABLED=true
REACT_APP_JEMPI_BASE_API_PORT=50001
KC_GRAFANA_SSO_ENABLED=true

# Identity Access Manager Keycloak
KC_FRONTEND_URL=http://10.216.0.201:9088
KC_GRAFANA_ROOT_URL=http://10.216.0.201:3000
KC_JEMPI_ROOT_URL=http://10.216.0.201:3033
KC_OPENHIM_ROOT_URL=http://10.216.0.201:9000

#OpenHIM configurations
OPENHIM_API_HOST=10.216.0.201
OPENHIM_CONSOLE_BASE_URL=http://10.216.0.201:9000
OPENHIM_CORE_MEDIATOR_HOSTNAME=10.216.0.201

# JeMPI remote configurations
REACT_APP_JEMPI_BASE_API_HOST=http://10.216.0.201
JEMPI_SESSION_DOMAIN_NAME=10.216.0.201
DOMAIN_NAME=10.216.0.201

# Over-ride defaults
JEMPI_ASYNC_RECEIVER_IMAGE_TAG=sd-dev
JEMPI_CONTROLLER_IMAGE_TAG=sd-dev
JEMPI_LINKER_IMAGE_TAG=sd-dev
JEMPI_API_IMAGE_TAG=sd-dev
JEMPI_API_KC_IMAGE_TAG=sd-dev
JEMPI_ETL_IMAGE_TAG=sd-dev
JEMPI_EM_SCALA_IMAGE_TAG=sd-dev
JEMPI_BOOTSTRAPPER_IMAGE_TAG=sd-dev
JEMPI_WEB_VERSION=sd-dev
JEMPI_LINKER_INSTANCES=1
KAFKA_JEMPI_AUDIT_TOPIC=JeMPI-mpi-mediator
POSTGRESQL_IP=postgres-1
POSTGRESQL_PORT=5432
POSTGRESQL_USER=users
POSTGRESQL_PASSWORD=instant101
POSTGRESQL_NOTIFICATIONS_DB=notifications_db
POSTGRESQL_AUDIT_DB=audit_db
POSTGRESQL_MPI_DB=mpi_db
LINKER_MIN_THRESHOLD=0.60
LINKER_MATCH_THRESHOLD=0.65
LINKER_MAX_THRESHOLD=0.70

MPI_MEDIATOR_IMAGE=jembi/mpi-mediator:sd-dev

